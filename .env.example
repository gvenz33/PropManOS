# Got My Rent — Supabase project: https://supabase.com/dashboard/project/mfylqvjzlnhvurauckuz
# Auth → URL configuration: add these Redirect URLs (and set Site URL to production domain):
#   http://localhost:3000/auth/callback
#   https://gotmyrent.com/auth/callback
#   https://www.gotmyrent.com/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Storage bucket id in Supabase (dashboard name: PropManOS)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=propmanos

# Server-only (Vercel env): rent reminder cron / future Edge Functions
SUPABASE_SERVICE_ROLE_KEY=

# Email reminders (Resend) — verify domain at resend.com
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=Got My Rent <noreply@gotmyrent.com>

# SMS reminders (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Daily rent reminders cron — set on Vercel; Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Payments / bank link (Plaid)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# ACH processing fee charged to tenant per bank payment (cents). Default 250 = $2.50
PLAID_ACH_FEE_CENTS=250


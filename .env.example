# Got My Rent — Supabase project: https://supabase.com/dashboard/project/mfylqvjzlnhvurauckuz
# Auth → URL configuration: set Site URL to https://gotmyrent.com and add Redirect URLs:
#   http://localhost:3000/**
#   https://gotmyrent.com/**
#   https://www.gotmyrent.com/**
#   https://*-gvenz33-4516s-projects.vercel.app/**
NEXT_PUBLIC_SITE_URL=https://gotmyrent.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Storage bucket id in Supabase (dashboard name: PropManOS)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=propmanos

# Server-only (Vercel env): rent reminder cron / future Edge Functions
SUPABASE_SERVICE_ROLE_KEY=

# Email reminders (Resend) — verify domain at resend.com
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=Got My Rent <noreply@gotmyrent.com>

# SMS reminders (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Daily rent reminders cron — set on Vercel; Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Payments / bank link (Plaid) — https://dashboard.plaid.com/developers/keys
# Bank Account (landlord payout) + tenant payment account use Plaid Link (Auth).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# ACH fee in cents — 0 = free for landlords and tenants
PLAID_ACH_FEE_CENTS=0

# Subscriptions + card rent payments (Stripe)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Dashboard Price IDs (otherwise Checkout uses inline price_data)
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

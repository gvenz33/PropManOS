# Supabase — PropManOS project: https://supabase.com/dashboard/project/mfylqvjzlnhvurauckuz
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Storage bucket id in Supabase (dashboard name: PropManOS)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=propmanos

# Server-only (Vercel env): rent reminder cron / future Edge Functions
SUPABASE_SERVICE_ROLE_KEY=

# Email (e.g. Resend) — wire in app/api or Edge Function
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=noreply@yourdomain.com

# SMS (e.g. Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments / bank link — connect when you add Stripe or Plaid
# STRIPE_SECRET_KEY=
# PLAID_CLIENT_ID=

# Optional: protect /api/cron/reminders
CRON_SECRET=
